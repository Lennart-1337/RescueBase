{$APP_DOMAIN} {
  encode zstd gzip

  # Better Auth owns the /api/auth prefix; Nest's domain routes do not.
  handle /api/auth/* {
    reverse_proxy api:3000
  }

  handle_path /api/* {
    reverse_proxy api:3000
  }

  handle /docs* {
    reverse_proxy api:3000
  }

  handle {
    reverse_proxy web:80
  }
}
